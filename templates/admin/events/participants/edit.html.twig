{% extends 'layout/admin.html.twig' %}
{% import 'partials/macros.html.twig' as m %}

{% block title %}{{ p.first_name }} {{ p.last_name }} · {{ event.name }}{% endblock %}

{% block content %}
  {% include 'partials/event_header.html.twig' %}

  <p><a href="{{ url('/admin/events/' ~ event.id ~ '/participants') }}">← {{ t('participants.back_to_list') }}</a></p>

  <section class="card stack form-narrow" aria-labelledby="person-title">
    <h2 class="h2" id="person-title">{{ p.first_name }} {{ p.last_name }}</h2>
    <p class="muted small">
      {{ t('participants.in_events', {count: p.event_count}) }} · {{ t('participants.pledge_count', {count: p.pledge_count}) }}
    </p>

    {% if perm.participants %}
      <form method="post" action="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id) }}" class="stack" novalidate>
        {{ csrf_field() }}
        <div class="grid-2">
          {{ m.field('first_name', t('participants.first_name'), input.first_name, errors, 'text', {required: true, maxlength: 80, autocomplete: 'off'}) }}
          {{ m.field('last_name', t('participants.last_name'), input.last_name, errors, 'text', {required: true, maxlength: 80, autocomplete: 'off'}) }}
        </div>
        {{ m.field('email', t('participants.email'), input.email, errors, 'email', {required: true, maxlength: 190, autocomplete: 'off'}) }}
        {% if p.event_count > 1 %}<p class="notice notice--info small">{{ t('participants.shared_person_hint', {count: p.event_count}) }}</p>{% endif %}
        {{ m.team_select('team_id', t('participants.team'), teams, input.team_id, errors) }}
        <div><button type="submit" class="btn btn--primary">{{ t('app.save') }}</button></div>
      </form>
    {% else %}
      <dl class="facts">
        <div><dt>{{ t('participants.email') }}</dt><dd class="break">{{ p.email }}</dd></div>
        <div><dt>{{ t('participants.team') }}</dt><dd>{{ p.team_name ?? '–' }}</dd></div>
      </dl>
    {% endif %}
  </section>

  <section class="card stack" aria-labelledby="pledges-title">
    <div class="section-head">
      <h2 class="h2" id="pledges-title">{{ t('participants.pledges_title') }}</h2>
      {% if can_pay %}<a href="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id ~ '/pledges/new') }}" class="btn btn--secondary btn--small">{{ t('pledges.admin.add') }}</a>{% endif %}
    </div>
    {% if sums %}
      <dl class="mail-counts money-counts money-counts--small">
        <div><dt>{{ t('laps.laps') }}</dt><dd>{{ p.did_not_start ? t('laps.dns_short') : (p.laps ?? '–') }}</dd></div>
        <div><dt>{{ t('payments.total.owed') }}</dt><dd>{{ sums.owed_cents|money }}</dd></div>
        <div><dt>{{ t('payments.total.paid') }}</dt><dd>{{ sums.paid_cents|money }}</dd></div>
        <div><dt>{{ t('payments.total.open') }}</dt><dd>{{ sums.open_cents|money }}</dd></div>
      </dl>
      <p><span class="badge badge--state-{{ sums.state }}">{{ t('payments.state_' ~ sums.state) }}</span>{% if sums.unknown_count > 0 %} <span class="muted small">{{ t('payments.plus_laps') }}</span>{% endif %}</p>
    {% endif %}
    {% if pledges is empty %}
      <p class="muted">{{ t('participants.no_pledges') }}</p>
    {% else %}
      <div class="table-wrap table-wrap--flat">
        <table class="table table--compact">
          <thead><tr>
            <th scope="col">{{ t('pledge.field.sponsor_name') }}</th>
            <th scope="col" class="num">{{ t('pledge.field.amount') }}</th>
            <th scope="col" class="num">{{ t('payments.total.owed') }}</th>
            <th scope="col">{{ t('pledge.payment.status') }}</th>
            {% if can_pay %}<th scope="col"><span class="visually-hidden">{{ t('events.teams.actions') }}</span></th>{% endif %}
          </tr></thead>
          <tbody>
            {% for pl in pledges %}
              <tr{{ pl.status == 'cancelled' ? ' class="is-muted"' }}>
                <td>
                  {% if pl.anonymized_at %}<strong class="muted">{{ t('pledges.anonymized') }}</strong><br>
                  {% else %}<strong>{{ pl.sponsor_name }}</strong><br>
                  <span class="muted small break">{{ pl.sponsor_email }}</span><br>{% endif %}
                  <span class="muted small">{{ pl.created_at|datetime }} · {{ t('pledge.source.' ~ pl.source) }} · {{ t('pledge.method.' ~ pl.payment_method) }}</span>
                  {% if pl.sponsor_message %}<br><span class="small">«{{ pl.sponsor_message }}»</span>{% endif %}
                </td>
                <td class="num nowrap">{{ pl.amount_cents|money }}{% if pl.type == 'per_lap' %}<br><span class="muted small">{{ t('pledge.per_lap_short') }}</span>{% endif %}</td>
                <td class="num nowrap">{{ pl.unknown ? '–' : pl.owed_cents|money }}</td>
                <td>
                  <span class="badge badge--pledge-{{ pl.status }}">{{ t('pledge.status.' ~ pl.status) }}</span>
                  {% if pl.status == 'paid' %}<br><span class="muted small">{{ pl.paid_at|date_ch }} · {{ t('pledge.method.' ~ pl.paid_method) }} · {{ pl.paid_amount_cents|money }}{% if pl.paid_by_name %} · {{ pl.paid_by_name }}{% endif %}</span>{% endif %}
                  {% if pl.status == 'cancelled' %}<br><span class="muted small">{{ pl.cancel_reason }}</span>{% endif %}
                  {% if pl.payment_requested_at %}<br><span class="muted small">{{ t('pledges.admin.requested_on', {date: pl.payment_requested_at|date_ch}) }}{% if pl.reminder_count > 0 %} · {{ t('pledges.admin.reminders', {count: pl.reminder_count}) }}{% endif %}</span>{% endif %}
                </td>
                {% if can_pay %}
                  <td class="actions-col">
                    {% if pl.status in ['open', 'cash_received'] %}
                      {% if not pl.unknown %}
                        <details class="inline-details">
                          <summary class="btn btn--secondary btn--small">{{ t('pledges.admin.mark_paid') }}</summary>
                          <form method="post" action="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id ~ '/pledges/' ~ pl.id ~ '/paid') }}" class="stack paid-form">
                            {{ csrf_field() }}
                            <label>{{ t('pledges.admin.paid_date') }} <input type="date" name="date" value="{{ today }}" max="{{ today }}"></label>
                            <label>{{ t('pledge.field.method') }} <select name="method">{% for v in ['twint', 'cash'] %}<option value="{{ v }}"{{ pl.payment_method == v ? ' selected' }}>{{ t('pledge.method.' ~ v) }}</option>{% endfor %}</select></label>
                            <label>{{ t('pledges.admin.paid_amount') }} <input type="text" name="amount" inputmode="decimal" value="{{ '%.2f'|format(pl.owed_cents / 100) }}"></label>
                            <button type="submit" class="btn btn--primary btn--small">{{ t('pledges.admin.confirm_paid') }}</button>
                          </form>
                        </details>
                      {% endif %}
                      <a href="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id ~ '/pledges/' ~ pl.id) }}" class="small">{{ t('pledges.admin.edit') }}</a>
                    {% elseif pl.status == 'paid' %}
                      <form method="post" action="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id ~ '/pledges/' ~ pl.id ~ '/unpaid') }}" data-confirm="{{ t('pledges.admin.unpaid_confirm') }}">
                        {{ csrf_field() }}<button type="submit" class="btn btn--link small">{{ t('pledges.admin.mark_unpaid') }}</button>
                      </form>
                    {% endif %}
                  </td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if can_pay and sums and sums.open_cents > 0 %}
        <form method="post" action="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id ~ '/paid') }}" class="all-paid" data-confirm="{{ t('pledges.admin.all_paid_confirm', {amount: sums.open_cents|money}) }}">
          {{ csrf_field() }}
          <strong>{{ t('pledges.admin.all_paid_title') }}</strong>
          <span class="muted small">{{ t('pledges.admin.all_paid_help') }}</span>
          <div class="all-paid__fields">
            <label>{{ t('pledges.admin.paid_date') }} <input type="date" name="date" value="{{ today }}" max="{{ today }}"></label>
            <label>{{ t('pledge.field.method') }} <select name="method"><option value="cash" selected>{{ t('pledge.method.cash') }}</option><option value="twint">{{ t('pledge.method.twint') }}</option></select></label>
            <button type="submit" class="btn btn--primary">{{ t('pledges.admin.all_paid_button', {amount: sums.open_cents|money}) }}</button>
          </div>
        </form>
      {% endif %}
      {% if can_pay and undo_group %}
        <form method="post" action="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id ~ '/paid/undo') }}" data-confirm="{{ t('pledges.admin.undo_confirm') }}">
          {{ csrf_field() }}<button type="submit" class="btn btn--link small">{{ t('pledges.admin.undo') }}</button>
        </form>
      {% endif %}
      {% if not can_pay %}<p class="muted small">{{ perm.payments ? t('pledges.admin.not_now') : t('pledges.admin.only_event_admin') }}</p>{% endif %}
    {% endif %}
  </section>

  <section class="card stack form-narrow" aria-labelledby="access-title">
    <h2 class="h2" id="access-title">{{ t('participants.access.title') }}</h2>
    <p class="muted">{{ t('participants.access.help') }}</p>
    <dl class="facts">
      <div><dt>{{ t('participants.access.invitation') }}</dt><dd>{% include 'admin/events/participants/_invite_state.html.twig' with {inv: invite, invited_at: p.invited_at} %}</dd></div>
      <div><dt>{{ t('participants.access.link_issued') }}</dt><dd>{{ p.magic_token_issued_at ? p.magic_token_issued_at|datetime : t('participants.access.no_link') }}</dd></div>
    </dl>
    {% if invite and invite.status == 'failed' and invite.last_error %}<p class="field__error small">{{ invite.last_error|split(':')|first|t }}</p>{% endif %}
    {% if perm.mail %}
      {% if not mail_configured %}
        <p class="notice notice--warning">{{ t('mails.not_configured') }}</p>
      {% endif %}
      <div class="button-row">
        {% if event.status == 'collecting' %}
          <form method="post" action="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id ~ '/invite') }}">
            {{ csrf_field() }}
            <button type="submit" class="btn btn--secondary"{{ mail_configured ? '' : ' disabled' }}>{{ p.invited_at ? t('participants.access.resend') : t('participants.access.send') }}</button>
          </form>
        {% endif %}
        {% if event.status in ['collecting', 'run_done', 'billing'] and p.magic_token_issued_at %}
          <form method="post" action="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id ~ '/link') }}" data-confirm="{{ t('participants.access.renew_confirm', {name: p.first_name}) }}">
            {{ csrf_field() }}
            <button type="submit" class="btn btn--secondary"{{ mail_configured ? '' : ' disabled' }}>{{ t('participants.access.renew') }}</button>
          </form>
        {% endif %}
      </div>
      <p class="muted small">{{ t('participants.access.renew_help') }}</p>
    {% else %}
      <p class="muted small">{{ t('mails.only_event_admin') }}</p>
    {% endif %}
  </section>

  {% if perm.participants %}
    <section class="card stack form-narrow" aria-labelledby="remove-title">
      <h2 class="h2" id="remove-title">{{ t('participants.remove_title') }}</h2>
      {% if can_remove %}
        <p class="muted">{{ t('participants.remove_help') }}</p>
        <form method="post" action="{{ url('/admin/events/' ~ event.id ~ '/participants/' ~ p.id) }}" data-confirm="{{ t('participants.remove_confirm', {name: p.first_name ~ ' ' ~ p.last_name}) }}">
          {{ csrf_field() }}
          <input type="hidden" name="action" value="remove">
          <button type="submit" class="btn btn--danger">{{ t('participants.remove') }}</button>
        </form>
      {% elseif p.pledge_count > 0 %}
        <p class="muted">{{ t('participants.remove_has_pledges') }}</p>
      {% else %}
        <p class="muted">{{ t('participants.list_closed') }}</p>
      {% endif %}
    </section>
  {% endif %}

  {% if history is not empty %}
    <details class="card history">
      <summary class="h3">{{ t('admin.audit.history', {count: history|length}) }}</summary>
      <ul class="history__list">
        {% for e in history %}
          <li>
            <span class="nowrap small muted">{{ e.created_at|datetime }} · {{ e.display_name ?? t('admin.audit.system') }}</span><br>
            <strong>{{ t('admin.audit.action.' ~ e.action) }}</strong>{% set lines = audit_details(e) %}{% if lines is not empty %} <span class="small">– {{ lines|join(', ') }}</span>{% endif %}
          </li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
{% endblock %}
