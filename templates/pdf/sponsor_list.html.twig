<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ t('pdf.title', {name: p.first_name ~ ' ' ~ p.last_name}) }}</title>
<style>
  @page { margin: 16mm 14mm 18mm; }
  body { font-family: "DejaVu Sans", sans-serif; font-size: 9.5pt; color: #14212E; }
  .head { width: 100%; border-bottom: 2pt solid {{ brand.primary_color }}; padding-bottom: 6pt; margin-bottom: 10pt; }
  .head td { vertical-align: top; }
  .logo { width: 48pt; height: 48pt; }
  .club { font-size: 13pt; font-weight: bold; }
  .event { font-size: 10pt; color: #3B4A58; }
  h1 { font-size: 16pt; margin: 4pt 0 2pt; }
  .muted { color: #586776; }
  .qr { text-align: right; }
  .qr img { width: 92pt; height: 92pt; }
  .qr div { font-size: 7.5pt; color: #586776; }
  table.list { width: 100%; border-collapse: collapse; margin-top: 8pt; }
  table.list th { text-align: left; font-size: 8pt; color: #3B4A58; border-bottom: 1pt solid #14212E; padding: 4pt 4pt; }
  table.list td { border-bottom: 0.6pt solid #B9C5D1; padding: 0 4pt; height: 22pt; vertical-align: middle; white-space: nowrap; }
  table.list td.filled { white-space: normal; }
  table.list td.filled { color: #14212E; }
  .box { display: inline-block; width: 8pt; height: 8pt; border: 0.8pt solid #14212E; margin-right: 2pt; vertical-align: middle; }
  .box.x { background: #14212E; }
  .note { margin-top: 8pt; font-size: 8pt; color: #586776; }
</style>
</head>
<body>
<table class="head"><tr>
  {% if logo_path %}<td style="width:56pt"><img src="{{ logo_path }}" class="logo"></td>{% endif %}
  <td>
    <div class="club">{{ brand.club_name }}</div>
    <div class="event">{{ event.name }}{% if event.event_date %} · {{ event.event_date|date('d.m.Y') }}{% endif %}{% if event.location %} · {{ event.location }}{% endif %}</div>
    <h1>{{ t('pdf.heading', {name: p.first_name ~ ' ' ~ p.last_name}) }}</h1>
    {% if brand.purpose %}<div class="muted">{{ t('public.invite.purpose', {purpose: brand.purpose}) }}</div>{% endif %}
    {% if event.lap_length_m %}<div class="muted">{{ t('public.invite.lap_length', {m: event.lap_length_m}) }}</div>{% endif %}
  </td>
  {% if qr %}<td class="qr" style="width:100pt"><img src="{{ qr }}"><div>{{ t('pdf.qr_hint') }}</div></td>{% endif %}
</tr></table>

<table class="list">
  <thead><tr>
    <th style="width:21%">{{ t('pdf.col.name') }}</th>
    <th style="width:23%">{{ t('pdf.col.email') }}</th>
    <th style="width:24%">{{ t('pdf.col.type') }}</th>
    <th style="width:13%">{{ t('pdf.col.amount') }}</th>
    <th style="width:19%">{{ t('pdf.col.method') }}</th>
  </tr></thead>
  <tbody>
  {% for pl in pledges %}
    <tr>
      <td class="filled">{{ pl.sponsor_name }}</td>
      <td class="filled muted">{{ t('pdf.online') }}</td>
      <td class="filled">{{ t('pledge.type.' ~ pl.type) }}</td>
      <td class="filled">{{ pl.amount_cents|money }}</td>
      <td class="filled"><span class="box{{ pl.payment_method == 'cash' ? ' x' }}"></span>{{ t('pledge.method.cash') }} &nbsp; <span class="box{{ pl.payment_method == 'twint' ? ' x' }}"></span>Twint</td>
    </tr>
  {% endfor %}
  {% for i in 1..empty_rows %}
    <tr><td></td><td></td><td><span class="box"></span>{{ t('pdf.flat_short') }} <span class="box"></span>{{ t('pdf.per_lap_short') }}</td><td></td><td><span class="box"></span>{{ t('pledge.method.cash') }} &nbsp; <span class="box"></span>Twint</td></tr>
  {% endfor %}
  </tbody>
</table>
<p class="note">{{ t('pdf.note') }}</p>
</body>
</html>
