{% extends 'mail/de/_layout.html.twig' %}
{% block content %}
<p style="margin:0 0 16px;font-size:20px;font-weight:bold;">{{ t('mail.hello', {name: first_name}) }}</p>
<p style="margin:0 0 16px;">{{ intro|nl2br }}</p>
{% if event.date or event.location %}<p style="margin:0 0 16px;color:#3B4A58;">{{ t('mail.invite.when_where', {date: event.date ?: '–', location: event.location ?: '–'}) }}</p>{% endif %}
{% include 'mail/de/_button.html.twig' with {href: magic_url, label: t('mail.invite.button')} %}
<p style="margin:0 0 12px;">{{ t('mail.invite.what_you_find') }}</p>
<p style="margin:0 0 12px;font-size:14px;color:#3B4A58;">{{ t('mail.invite.keep_link') }}</p>
<p style="margin:0;font-size:13px;color:#586776;word-break:break-all;">{{ t('mail.link_fallback') }}<br><a href="{{ magic_url }}" style="color:#3B4A58;">{{ magic_url }}</a></p>
{% endblock %}
