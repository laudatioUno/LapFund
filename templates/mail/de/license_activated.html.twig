{% extends 'mail/de/_layout.html.twig' %}
{% block content %}
<p style="margin:0 0 16px;font-size:20px;font-weight:bold;">{{ t('mail.hello', {name: first_name}) }}</p>
{% if booking.paid_via == 'website' %}
<p style="margin:0 0 16px;">{{ t('mail.license.activated_credit', {event: booking.event_name}) }}</p>
{% else %}
<p style="margin:0 0 16px;">{{ t('mail.license.activated_paid', {amount: total|price, reference: booking.reference, event: booking.event_name}) }}</p>
{% endif %}
<p style="margin:0 0 16px;">{{ t('mail.license.activated_next') }}</p>
{% include 'mail/de/_button.html.twig' with {href: event_url, label: t('mail.license.activated_button')} %}
<p style="margin:0;font-size:14px;color:#3B4A58;">{{ t('mail.license.activated_receipt') }}</p>
{% endblock %}
