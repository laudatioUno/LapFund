{% extends 'layout/base.html.twig' %}
{% import 'partials/macros.html.twig' as m %}

{% block body_class %}page-auth{% endblock %}

{% block body %}
<div class="auth">
  <header class="auth__brand">
    {% if brand.logo %}
      <img src="{{ url('/media/' ~ brand.logo) }}" alt="" class="auth__logo">
    {% endif %}
    <span class="auth__club">{{ brand.club_name }}</span>
  </header>
  <main class="card auth__card" id="main">
    {{ m.flashes(flashes) }}
    {% block content %}{% endblock %}
  </main>
  <footer class="auth__footer">LapFund {{ version }}</footer>
</div>
{% endblock %}
