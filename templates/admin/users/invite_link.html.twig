{% extends 'layout/admin.html.twig' %}

{% block title %}{{ t('admin.users.invite_link_title') }}{% endblock %}

{% block content %}
  <header class="page-head">
    <div>
      <a href="{{ url('/admin/users') }}" class="back">← {{ t('app.nav.users') }}</a>
      <h1 class="h1">{{ t('admin.users.invite_link_title') }}</h1>
    </div>
  </header>

  <section class="card stack">
    <p>{{ t('admin.users.invite_link_text', {name: user.display_name, hours: hours}) }}</p>
    <div class="copy-row">
      <label for="invite-link" class="visually-hidden">{{ t('admin.users.invite_link_title') }}</label>
      <input id="invite-link" type="text" value="{{ link }}" readonly class="input--mono">
      <button type="button" class="btn btn--primary" data-copy-target="invite-link" data-copied="{{ t('app.copied') }}">{{ t('app.copy') }}</button>
    </div>
    <div class="notice notice--info">{{ t('admin.users.invite_link_hint') }}</div>
    <p><a href="{{ url('/admin/users/' ~ user.id) }}" class="btn btn--secondary">{{ t('admin.users.to_user') }}</a></p>
  </section>
{% endblock %}
