{% extends 'mail/de/_layout.html.twig' %}
{% block content %}
<p style="margin:0 0 16px;font-size:20px;font-weight:bold;">{{ t('mail.hello', {name: first_name}) }}</p>
<p style="margin:0 0 16px;">{{ t('mail.new_sponsor.text', {event: event.name}) }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 16px;background:#F3F6F9;border-radius:10px;"><tr><td style="padding:14px 16px;">
<p style="margin:0 0 4px;font-size:18px;font-weight:bold;">{{ sponsor }}</p>
<p style="margin:0;font-size:16px;">{{ amount }}{% if per_lap %} {{ t('pledge.per_lap_short') }}{% endif %}</p>
{% if message %}<p style="margin:8px 0 0;font-size:15px;font-style:italic;">«{{ message }}»</p>{% endif %}
</td></tr></table>
<p style="margin:0 0 16px;">{{ t(count == 1 ? 'mail.new_sponsor.totals_one' : 'mail.new_sponsor.totals', {count: count, flat: flat_total, per_lap: per_lap_total}) }}</p>
<p style="margin:0 0 16px;">{{ t('mail.new_sponsor.thanks') }}</p>
{% include 'mail/de/_button.html.twig' with {href: magic_url, label: t('mail.invite.button')} %}
<p style="margin:0;font-size:13px;color:#586776;word-break:break-all;">{{ t('mail.link_fallback') }}<br><a href="{{ magic_url }}" style="color:#3B4A58;">{{ magic_url }}</a></p>
{% endblock %}
